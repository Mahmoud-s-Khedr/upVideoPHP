{
    "name": "videosystem/php-hls-streaming",
    "description": "PHP video upload, transcoding, and HLS streaming system",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "aws/aws-sdk-php": "^3.0",
        "vlucas/phpdotenv": "^5.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": {
            "VideoSystem\\": "src/",
            "VideoSystem\\Database\\Seeders\\": "database/seeders/"
        },
        "classmap": [
            "config/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "VideoSystem\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php vendor/bin/phpunit",
        "test:unit": "php vendor/bin/phpunit --testsuite Unit",
        "test:integration": "php vendor/bin/phpunit --testsuite Integration"
    },
    "config": {
        "optimize-autoloader": true
    }
}
