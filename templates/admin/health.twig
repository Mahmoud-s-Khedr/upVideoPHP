{% extends "layout.twig" %}
{% set active_page = 'health' %}

{% block title %}System Health{% endblock %}

{% block content %}
<section class="page-hero">
  <div>
    <span class="page-kicker">Reliability</span>
    <h1 class="page-title">System Health</h1>
    <p class="page-subtitle">Check database reachability, work-directory capacity, active workers, stale claims, and recent failures.</p>
  </div>
</section>

<div class="metric-grid mb-4">
  <article class="metric-card">
    <div class="d-flex align-items-center justify-content-between">
      <span class="metric-label">Database</span>
      <i class="bi {{ db_ok ? 'bi-database-check' : 'bi-database-x' }} {{ db_ok ? 'text-success' : 'text-danger' }}"></i>
    </div>
    <div class="metric-value">{{ db_ok ? 'OK' : 'Down' }}</div>
    <div class="metric-meta">{{ db_ok ? 'Database connection is reachable.' : 'Database is currently unreachable.' }}</div>
  </article>

  <article class="metric-card">
    <div class="d-flex align-items-center justify-content-between">
      <span class="metric-label">Disk</span>
      <i class="bi bi-hdd {{ disk_ok ? 'text-success' : 'text-danger' }}"></i>
    </div>
    <div class="metric-value">
      {% if disk_total %}{{ ((disk_total - disk_free) / disk_total * 100)|round }}%{% else %}N/A{% endif %}
    </div>
    <div class="metric-meta">
      {% if disk_free is not null %}
        {{ (disk_free / 1073741824)|round(1) }} GB free in {{ work_dir }}
      {% else %}
        Work directory not found.
      {% endif %}
    </div>
  </article>

  <article class="metric-card">
    <div class="d-flex align-items-center justify-content-between">
      <span class="metric-label">Workers</span>
      <i class="bi bi-cpu text-info"></i>
    </div>
    <div class="metric-value">{{ active_jobs|length }}</div>
    <div class="metric-meta">{{ queued_count }} queued, {{ stale_jobs|length }} stale claims.</div>
  </article>
</div>

<div class="row g-4 mb-4">
  <div class="col-xl-7">
    <section class="admin-card h-100">
      <div class="card-header">Active Encoding Jobs</div>
      <div class="card-body p-0">
        {% if active_jobs|length > 0 %}
          <div class="table-responsive">
            <table class="table table-hover align-middle">
              <thead>
                <tr>
                  <th>Job</th>
                  <th>PID</th>
                  <th>Video</th>
                  <th>Rendition</th>
                  <th>Progress</th>
                  <th>Running Since</th>
                </tr>
              </thead>
              <tbody>
                {% for j in active_jobs %}
                <tr>
                  <td>#{{ j.id }}</td>
                  <td><code>{{ j.worker_pid }}</code></td>
                  <td><a href="/admin/videos/{{ j.video_uuid }}" class="fw-semibold text-decoration-none">{{ j.original_name|slice(0, 42) }}</a></td>
                  <td>{{ j.current_rendition ?? '—' }}</td>
                  <td style="min-width: 150px;">
                    <div class="progress" style="height: 0.8rem;">
                      <div class="progress-bar bg-info" style="width:{{ j.progress_pct }}%">{{ j.progress_pct }}%</div>
                    </div>
                  </td>
                  <td class="small text-muted">{{ j.claimed_at }}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <div class="empty-state">
            <div class="empty-state-icon"><i class="bi bi-cpu"></i></div>
            <div class="fw-semibold text-dark mb-1">No active encoding jobs</div>
            <div>Workers will appear here as soon as they claim queued jobs.</div>
          </div>
        {% endif %}
      </div>
    </section>
  </div>

  <div class="col-xl-5">
    <section class="admin-card h-100">
      <div class="card-header">Disk Thresholds</div>
      <div class="card-body">
        {% if disk_total %}
          {% set pct = ((disk_total - disk_free) / disk_total * 100)|round %}
          <div class="progress mb-3" style="height: 1rem;">
            <div class="progress-bar {{ pct > 85 ? 'bg-danger' : (pct > 65 ? 'bg-warning' : 'bg-success') }}" style="width:{{ pct }}%">{{ pct }}%</div>
          </div>
          <div class="stack-card mb-3">
            <div class="metric-label">Free Space</div>
            <div class="fw-semibold text-dark">{{ (disk_free / 1073741824)|round(1) }} GB</div>
          </div>
          <div class="stack-card mb-3">
            <div class="metric-label">Total Capacity</div>
            <div class="fw-semibold text-dark">{{ (disk_total / 1073741824)|round(1) }} GB</div>
          </div>
          <div class="stack-card">
            <div class="metric-label">Minimum Required</div>
            <div class="fw-semibold text-dark">{{ (min_free_bytes / 1073741824)|round(1) }} GB</div>
          </div>
        {% else %}
          <div class="empty-state">
            <div class="empty-state-icon"><i class="bi bi-hdd"></i></div>
            <div class="fw-semibold text-dark mb-1">Disk telemetry unavailable</div>
            <div>Check the configured work directory path.</div>
          </div>
        {% endif %}
      </div>
    </section>
  </div>
</div>

{% if stale_jobs|length > 0 %}
<section class="admin-card mb-4">
  <div class="card-header">Stale Jobs</div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>Job</th>
            <th>PID</th>
            <th>Video UUID</th>
            <th>Claimed At</th>
          </tr>
        </thead>
        <tbody>
          {% for j in stale_jobs %}
          <tr>
            <td>#{{ j.id }}</td>
            <td><code>{{ j.worker_pid }}</code></td>
            <td><a href="/admin/videos/{{ j.video_uuid }}" class="font-monospace text-decoration-none">{{ j.video_uuid }}</a></td>
            <td class="small text-muted">{{ j.claimed_at }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="card-footer bg-white small text-muted">The reaper process resets stale claims automatically after the configured timeout.</div>
  </div>
</section>
{% endif %}

{% if recent_failures|length > 0 %}
<section class="admin-card">
  <div class="card-header">Recent Failures</div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>Job</th>
            <th>Video</th>
            <th>Attempts</th>
            <th>Error Excerpt</th>
            <th>Failed At</th>
          </tr>
        </thead>
        <tbody>
          {% for f in recent_failures %}
          <tr>
            <td>#{{ f.id }}</td>
            <td><a href="/admin/videos/{{ f.video_uuid }}" class="text-decoration-none fw-semibold">{{ f.original_name|slice(0, 42) }}</a></td>
            <td>{{ f.attempts }}</td>
            <td class="small text-danger">{{ f.last_error|slice(0, 120)|default('—') }}</td>
            <td class="small text-muted">{{ f.updated_at|slice(0, 16) }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>
{% endif %}
{% endblock %}
