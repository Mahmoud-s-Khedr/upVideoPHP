<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Admin{% endblock %} — VideoSystem</title>
  <link rel="icon" href="/favicon.ico">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body { font-size: 0.9rem; }
    .sidebar { min-height: 100vh; background: #212529; }
    .sidebar .nav-link { color: #adb5bd; padding: .5rem 1rem; }
    .sidebar .nav-link:hover,
    .sidebar .nav-link.active { color: #fff; background: #343a40; border-radius: .375rem; }
    .sidebar .nav-link i { margin-right: .5rem; }
    .sidebar .brand { color: #fff; font-weight: 700; font-size: 1.1rem; padding: 1rem; border-bottom: 1px solid #343a40; }
    .main-content { padding: 1.5rem; }
    .badge-status-pending    { background: #6c757d; }
    .badge-status-queued     { background: #0dcaf0; color:#000; }
    .badge-status-processing { background: #ffc107; color:#000; }
    .badge-status-uploading  { background: #fd7e14; color:#fff; }
    .badge-status-ready      { background: #198754; }
    .badge-status-error      { background: #dc3545; }
    .badge-status-claimed    { background: #ffc107; color:#000; }
    .badge-status-done       { background: #198754; }
    .badge-status-failed     { background: #dc3545; }
    .token-reveal { font-family: monospace; font-size: .8rem; word-break: break-all; }
  </style>
</head>
<body>
<div class="d-flex">
  <!-- Sidebar -->
  <nav class="sidebar d-flex flex-column p-2" style="width:220px;min-width:220px;">
    <div class="brand mb-3"><i class="bi bi-camera-video-fill"></i> VideoSystem</div>
    <ul class="nav flex-column gap-1">
      <li class="nav-item">
        <a class="nav-link {% if active_page == 'dashboard' %}active{% endif %}" href="/admin">
          <i class="bi bi-speedometer2"></i> Dashboard
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link {% if active_page == 'videos' %}active{% endif %}" href="/admin/videos">
          <i class="bi bi-film"></i> Videos
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link {% if active_page == 'jobs' %}active{% endif %}" href="/admin/jobs">
          <i class="bi bi-cpu"></i> Encoding Jobs
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link {% if active_page == 'api_keys' %}active{% endif %}" href="/admin/api-keys">
          <i class="bi bi-key"></i> API Keys
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link {% if active_page == 'access_log' %}active{% endif %}" href="/admin/access-log">
          <i class="bi bi-list-ul"></i> Access Log
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link {% if active_page == 'health' %}active{% endif %}" href="/admin/health">
          <i class="bi bi-heart-pulse"></i> Health
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link {% if active_page == 'users' %}active{% endif %}" href="/admin/users">
          <i class="bi bi-people"></i> Users
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link {% if active_page == 'playlists' %}active{% endif %}" href="/admin/playlists">
          <i class="bi bi-collection-play"></i> Playlists
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link {% if active_page == 'embed_settings' %}active{% endif %}" href="/admin/embed-settings">
          <i class="bi bi-code-slash"></i> Embed Settings
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link {% if active_page == 'ad_analytics' %}active{% endif %}" href="/admin/ad-analytics">
          <i class="bi bi-bar-chart-line"></i> Video Ad Analytics
        </a>
      </li>
    </ul>
    <div class="mt-auto border-top border-secondary pt-2">
      <small class="text-secondary d-block px-2 mb-1">{{ admin_username }}</small>
      <form method="POST" action="/admin/logout">
        <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
        <button type="submit" class="btn btn-sm btn-outline-secondary w-100">
          <i class="bi bi-box-arrow-left"></i> Logout
        </button>
      </form>
    </div>
  </nav>

  <!-- Main content -->
  <div class="main-content flex-grow-1">
    {% if flash %}
      <div class="alert alert-{{ flash.type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
        {{ flash.message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    {% endif %}

    {% block content %}{% endblock %}
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block scripts %}{% endblock %}
</body>
</html>
