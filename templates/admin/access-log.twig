{% extends "layout.twig" %}
{% set active_page = 'access_log' %}

{% block title %}Access Log{% endblock %}

{% block content %}
<section class="page-hero">
  <div>
    <span class="page-kicker">Audit Trail</span>
    <h1 class="page-title">Access Log</h1>
    <p class="page-subtitle">Review session-level watch, embed, playback, and deny events without the segment-level request noise.</p>
    <div class="page-meta-badge">
      <i class="bi bi-list-ul"></i>
      <span>{{ total }} log entries{% if uuid_filter or action_filter %} matching the current filter{% endif %}</span>
    </div>
  </div>
</section>

<form class="filter-bar" method="GET" action="/admin/access-log">
  <div class="filter-field">
    <label class="form-label" for="uuid_filter">Video UUID</label>
    <input type="text" id="uuid_filter" name="uuid" value="{{ uuid_filter }}" placeholder="Filter by video UUID" class="form-control form-control-sm">
  </div>
  <div class="filter-field">
    <label class="form-label" for="action_filter">Action</label>
    <select id="action_filter" name="action" class="form-select form-select-sm">
      <option value="" {{ action_filter == '' ? 'selected' : '' }}>All actions</option>
      {% for a in valid_actions %}
        <option value="{{ a }}" {{ action_filter == a ? 'selected' : '' }}>{{ a }}</option>
      {% endfor %}
    </select>
  </div>
  <div class="filter-actions">
    <button class="btn btn-primary btn-sm" type="submit">Apply Filter</button>
    {% if uuid_filter or action_filter %}
      <a href="/admin/access-log" class="btn btn-outline-secondary btn-sm">Clear</a>
    {% endif %}
  </div>
</form>

<section class="admin-card">
  <div class="card-header d-flex align-items-center justify-content-between">
    <span>Playback Events</span>
    <span class="highlight-chip"><i class="bi bi-journal-text"></i> {{ total }} rows</span>
  </div>
  <div class="card-body p-0">
    {% if logs %}
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead>
            <tr>
              <th>#</th>
              <th>Video</th>
              <th>Action</th>
              <th>IP</th>
              <th>Session</th>
              <th>Details</th>
              <th>When</th>
            </tr>
          </thead>
          <tbody>
            {% for l in logs %}
            <tr>
              <td class="small text-muted">{{ l.id }}</td>
              <td>
                <a href="/admin/videos/{{ l.video_uuid }}" class="fw-semibold text-decoration-none font-monospace">{{ l.video_uuid|slice(0, 8) }}…</a>
                <div class="small text-muted">{{ l.original_name|slice(0, 42) }}</div>
              </td>
              <td>
                <span class="badge text-bg-light border">{{ l.action }}</span>
              </td>
              <td><code class="small">{{ l.ip_address }}</code></td>
              <td class="small text-muted font-monospace">{{ l.session_id ?? '—' }}</td>
              <td class="small text-muted font-monospace">{{ l.details_json ?? '—' }}</td>
              <td class="small text-muted">{{ l.created_at }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      <div class="empty-state">
        <div class="empty-state-icon"><i class="bi bi-journal-text"></i></div>
        <div class="fw-semibold text-dark mb-1">No access log entries found</div>
        <div>Update the filters or wait for player traffic to generate new events.</div>
      </div>
    {% endif %}
  </div>
</section>

{% if total_pages > 1 %}
<nav class="mt-3">
  <ul class="pagination pagination-sm">
    {% for p in 1..total_pages %}
    <li class="page-item {{ p == page ? 'active' : '' }}">
      <a class="page-link" href="/admin/access-log?page={{ p }}{{ uuid_filter ? '&uuid=' ~ uuid_filter|url_encode : '' }}{{ action_filter ? '&action=' ~ action_filter|url_encode : '' }}">{{ p }}</a>
    </li>
    {% endfor %}
  </ul>
</nav>
{% endif %}
{% endblock %}
