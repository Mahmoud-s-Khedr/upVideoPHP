{% extends "layout.twig" %}
{% set active_page = 'users' %}

{% block title %}Admin Users{% endblock %}

{% block content %}
<section class="page-hero">
  <div>
    <span class="page-kicker">Administration</span>
    <h1 class="page-title">Admin Users</h1>
    <p class="page-subtitle">Manage operator accounts for the admin console and keep access limited to trusted team members.</p>
    <div class="page-meta-badge">
      <i class="bi bi-people"></i>
      <span>{{ users|length }} admin users configured</span>
    </div>
  </div>
</section>

<div class="row g-4">
  <div class="col-xl-8">
    <section class="admin-card h-100">
      <div class="card-header d-flex align-items-center justify-content-between">
        <span>Team Members</span>
        <span class="highlight-chip"><i class="bi bi-person-badge"></i> {{ users|length }} total</span>
      </div>
      <div class="card-body p-0">
        {% if users %}
          <div class="table-responsive">
            <table class="table table-hover align-middle">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Username</th>
                  <th>Created</th>
                  <th>Updated</th>
                  <th class="text-end">Action</th>
                </tr>
              </thead>
              <tbody>
                {% for u in users %}
                <tr>
                  <td class="small text-muted">{{ u.id }}</td>
                  <td>
                    <span class="fw-semibold">{{ u.username }}</span>
                    {% if u.id == admin_id %}<span class="badge badge-status-ready ms-1">you</span>{% endif %}
                  </td>
                  <td class="small text-muted">{{ u.created_at|slice(0, 10) }}</td>
                  <td class="small text-muted">{{ u.updated_at|slice(0, 10) }}</td>
                  <td class="text-end">
                    {% if u.id != admin_id %}
                    <form method="POST" action="/admin/users/{{ u.id }}/delete" class="d-inline" onsubmit="return confirm('Delete admin user {{ u.username|e('js') }}? This cannot be undone.');">
                      <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                      <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
                    </form>
                    {% else %}
                      <span class="small text-muted">Current session</span>
                    {% endif %}
                  </td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <div class="empty-state">
            <div class="empty-state-icon"><i class="bi bi-people"></i></div>
            <div class="fw-semibold text-dark mb-1">No admin users found</div>
            <div>Create an account to grant console access.</div>
          </div>
        {% endif %}
      </div>
    </section>
  </div>

  <div class="col-xl-4">
    <section class="admin-card">
      <div class="card-header">Create Admin User</div>
      <div class="card-body">
        <p class="section-hint mb-3">Passwords are set directly here and should be rotated with care.</p>
        <form method="POST" action="/admin/users/create">
          <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
          <div class="mb-3">
            <label class="form-label" for="new_username">Username</label>
            <input type="text" class="form-control" id="new_username" name="username" required minlength="3" maxlength="64" pattern="[a-zA-Z0-9_.\-]+" placeholder="e.g. john">
            <div class="form-text">3-64 characters: letters, digits, `_`, `.`, `-`.</div>
          </div>
          <div class="mb-3">
            <label class="form-label" for="new_password">Password</label>
            <input type="password" class="form-control" id="new_password" name="password" required minlength="8">
          </div>
          <div class="mb-4">
            <label class="form-label" for="new_password_confirm">Confirm Password</label>
            <input type="password" class="form-control" id="new_password_confirm" name="password_confirm" required minlength="8">
          </div>
          <button type="submit" class="btn btn-primary w-100"><i class="bi bi-person-plus"></i> Create User</button>
        </form>
      </div>
    </section>
  </div>
</div>
{% endblock %}
