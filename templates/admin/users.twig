{% extends "layout.twig" %}
{% set active_page = 'users' %}

{% block title %}Admin Users{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="mb-0">Admin Users <span class="badge bg-secondary">{{ users|length }}</span></h4>
</div>

<div class="row g-3">
  <div class="col-12">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0 align-middle">
          <thead class="table-light">
            <tr><th>#</th><th>Username</th><th>Created</th><th>Updated</th><th></th></tr>
          </thead>
          <tbody>
          {% for u in users %}
          <tr>
            <td class="text-muted small">{{ u.id }}</td>
            <td>
              {{ u.username }}
              {% if u.id == admin_id %}<span class="badge bg-primary ms-1">you</span>{% endif %}
            </td>
            <td class="text-muted small">{{ u.created_at|slice(0,10) }}</td>
            <td class="text-muted small">{{ u.updated_at|slice(0,10) }}</td>
            <td>
              {% if u.id != admin_id %}
              <form method="POST" action="/admin/users/{{ u.id }}/delete" class="d-inline"
                    onsubmit="return confirm('Delete admin user {{ u.username|e('js') }}? This cannot be undone.');">
                <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                <button type="submit" class="btn btn-danger btn-sm py-0 px-2">
                  <i class="bi bi-trash"></i>
                </button>
              </form>
              {% endif %}
            </td>
          </tr>
          {% else %}
          <tr><td colspan="5" class="text-center text-muted py-4">No users found.</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-12 col-md-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white fw-semibold">Create Admin User</div>
      <div class="card-body">
        <form method="POST" action="/admin/users/create">
          <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
          <div class="mb-3">
            <label class="form-label" for="new_username">Username</label>
            <input type="text" class="form-control" id="new_username" name="username"
                   required minlength="3" maxlength="64" pattern="[a-zA-Z0-9_.\-]+"
                   placeholder="e.g. john">
            <div class="form-text">3–64 characters: letters, digits, _ . -</div>
          </div>
          <div class="mb-3">
            <label class="form-label" for="new_password">Password</label>
            <input type="password" class="form-control" id="new_password" name="password"
                   required minlength="8">
            <div class="form-text">Minimum 8 characters.</div>
          </div>
          <div class="mb-3">
            <label class="form-label" for="new_password_confirm">Confirm Password</label>
            <input type="password" class="form-control" id="new_password_confirm"
                   name="password_confirm" required minlength="8">
          </div>
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-person-plus"></i> Create User
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
{% endblock %}
