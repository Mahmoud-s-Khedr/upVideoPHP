{% extends "layout.twig" %}
{% set active_page = 'videos' %}

{% block title %}Video — {{ video.uuid|slice(0,8) }}{% endblock %}

{% block content %}
<section class="page-hero">
  <div>
    <span class="page-kicker">Video Detail</span>
    <h1 class="page-title">{{ video.original_name|slice(0, 64) }}</h1>
    <p class="page-subtitle">Review metadata, manage target qualities, inspect encoding progress, and maintain subtitle tracks from one screen.</p>
    <div class="page-meta-badge">
      <span class="badge badge-status-{{ video.status }}" id="video-detail-status">{{ video.status }}</span>
      <span class="font-monospace">{{ video.uuid }}</span>
    </div>
  </div>
  <div class="page-actions">
    <a href="/admin/videos" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to Videos</a>
    <a href="/admin/videos/{{ video.uuid }}/embed" class="btn btn-primary"><i class="bi bi-code-slash"></i> Embed Settings</a>
  </div>
</section>

<div class="row g-4 mb-4">
  <div class="col-xl-6">
    <section class="admin-card h-100">
      <div class="card-header">Metadata</div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-sm-4">UUID</dt><dd class="col-sm-8 font-monospace small">{{ video.uuid }}</dd>
          <dt class="col-sm-4">Duration</dt><dd class="col-sm-8">{{ video.duration_sec ? video.duration_sec ~ 's' : '—' }}</dd>
          <dt class="col-sm-4">File size</dt><dd class="col-sm-8">{{ video.size_bytes ? (video.size_bytes / 1048576)|round(2) ~ ' MB' : '—' }}</dd>
          <dt class="col-sm-4">Created</dt><dd class="col-sm-8 small">{{ video.created_at }}</dd>
          <dt class="col-sm-4">Updated</dt><dd class="col-sm-8 small">{{ video.updated_at }}</dd>
          <dt class="col-sm-4">Poster</dt><dd class="col-sm-8 font-monospace small">{{ video.poster_b2_key ?? '—' }}</dd>
          <dt class="col-sm-4">Sprite</dt><dd class="col-sm-8 font-monospace small">{{ video.sprite_b2_key ?? '—' }}</dd>
          <dt class="col-sm-4">Original B2</dt><dd class="col-sm-8 font-monospace small">{{ video.original_b2_key ?? '—' }}</dd>
          <dt class="col-sm-4">Original deleted</dt><dd class="col-sm-8 small">{{ video.original_deleted_at ?? '—' }}</dd>
          {% if video.error_message %}
            <dt class="col-sm-4 text-danger">Error</dt><dd class="col-sm-8 small text-danger">{{ video.error_message }}</dd>
          {% endif %}
        </dl>
      </div>
    </section>
  </div>

  <div class="col-xl-6">
    <section class="admin-card h-100">
      <div class="card-header">Encoding Job</div>
      <div class="card-body">
        {% if job %}
          <dl class="row mb-0">
            <dt class="col-sm-4">Job ID</dt><dd class="col-sm-8">#{{ job.id }}</dd>
            <dt class="col-sm-4">Status</dt><dd class="col-sm-8"><span class="badge badge-status-{{ job.status }}">{{ job.status }}</span></dd>
            <dt class="col-sm-4">Attempts</dt><dd class="col-sm-8">{{ job.attempts }} / {{ job.max_attempts }}</dd>
            <dt class="col-sm-4">Progress</dt>
            <dd class="col-sm-8">
              <div class="progress mb-2" style="height: 0.9rem;" id="video-detail-progress-wrap">
                <div class="progress-bar bg-info" id="video-detail-progress-bar" style="width:{{ job.progress_pct }}%">{{ job.progress_pct }}%</div>
              </div>
              <small class="text-muted d-block" id="video-detail-stage">
                {{ job.current_stage ? job.current_stage|replace({'_': ' '})|title : 'Queued' }}
              </small>
              <small class="text-muted d-block" id="video-detail-rendition">
                {% if job.current_rendition %}Current rendition: {{ job.current_rendition }}{% endif %}
              </small>
            </dd>
            <dt class="col-sm-4">Worker PID</dt><dd class="col-sm-8">{{ job.worker_pid ?? '—' }}</dd>
            <dt class="col-sm-4">Claimed at</dt><dd class="col-sm-8 small">{{ job.claimed_at ?? '—' }}</dd>
            <dt class="col-sm-4">Retry after</dt><dd class="col-sm-8 small">{{ job.retry_after ?? '—' }}</dd>
            <dt class="col-sm-4">Updated</dt><dd class="col-sm-8 small">{{ job.updated_at }}</dd>
            {% if job.last_error %}
              <dt class="col-sm-4 text-danger">Last error</dt>
              <dd class="col-sm-8"><pre class="small text-danger mb-0" style="white-space: pre-wrap; max-height: 120px; overflow: auto;">{{ job.last_error }}</pre></dd>
            {% endif %}
          </dl>
        {% else %}
          <div class="empty-state">
            <div class="empty-state-icon"><i class="bi bi-cpu"></i></div>
            <div class="fw-semibold text-dark mb-1">No encoding job found</div>
            <div>This video has not been queued yet.</div>
          </div>
        {% endif %}
      </div>
    </section>
  </div>
</div>

<section class="admin-card mb-4">
  <div class="card-header d-flex align-items-center justify-content-between">
    <span>Target Qualities</span>
    {% if video.status in ['pending', 'queued'] %}
      <span class="highlight-chip"><i class="bi bi-pencil-square"></i> Editable</span>
    {% else %}
      <span class="highlight-chip"><i class="bi bi-lock"></i> Locked after encoding starts</span>
    {% endif %}
  </div>
  <div class="card-body">
    {% if video.status in ['pending', 'queued'] %}
      {% if video.status == 'pending' %}
        <div class="panel-note mb-3">
          <i class="bi bi-info-circle"></i>
          This video is pending. Encoding will not start until you save target qualities below.
        </div>
      {% endif %}

      <form method="POST" action="/admin/videos/{{ video.uuid }}/qualities">
        <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
        <div class="row g-3 mb-3">
          {% for label in all_quality_labels %}
            {% set label_height = {'1080p': 1080, '720p': 720, '540p': 540, '480p': 480, '360p': 360} %}
            {% set too_low = video.source_height is not null and video.source_height < label_height[label] %}
            {% set is_checked = target_qualities is null or label in target_qualities %}
            <div class="col-sm-6 col-lg-4">
              <label class="quality-tile {% if too_low %}opacity-75{% endif %}" {% if too_low %}title="Source height ({{ video.source_height }}px) is too low for {{ label }} and will be skipped automatically"{% endif %}>
                <input class="form-check-input" type="checkbox" name="qualities[]" value="{{ label }}" {% if is_checked and not too_low %}checked{% endif %} {% if too_low %}disabled{% endif %}>
                <span>
                  <span class="d-block fw-semibold quality-tile-title">{{ label }}</span>
                  <span class="small text-muted">
                    {% if too_low %}
                      Source height too low. This rendition will be skipped.
                    {% else %}
                      Include this rendition in the encoding queue.
                    {% endif %}
                  </span>
                </span>
              </label>
            </div>
          {% endfor %}
        </div>
        {% if video.source_height %}
          <p class="small text-muted mb-3"><i class="bi bi-info-circle"></i> Source height: <strong>{{ video.source_height }}px</strong>. Labels above source height will be skipped even if checked.</p>
        {% endif %}
        <button type="submit" class="btn btn-primary"><i class="bi bi-floppy"></i> Save qualities{% if video.status == 'pending' %} and queue{% endif %}</button>
      </form>
    {% else %}
      <div class="d-flex flex-wrap gap-2">
        {% if target_qualities %}
          {% for label in target_qualities %}
            <span class="badge text-bg-light border fs-6">{{ label }}</span>
          {% endfor %}
        {% else %}
          <span class="text-muted">All applicable rungs (no selection stored)</span>
        {% endif %}
      </div>
      {% if video.source_height %}
        <p class="small text-muted mt-3 mb-0"><i class="bi bi-info-circle"></i> Source height: <strong>{{ video.source_height }}px</strong></p>
      {% endif %}
    {% endif %}
  </div>
</section>

{% if renditions|length > 0 %}
<section class="admin-card mb-4">
  <div class="card-header">Renditions</div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr><th>Label</th><th>Resolution</th><th>Bitrate</th><th>B2 Key Prefix</th></tr>
        </thead>
        <tbody>
          {% for r in renditions %}
          <tr>
            <td><span class="badge text-bg-light border">{{ r.label }}</span></td>
            <td>{{ r.width }}x{{ r.height }}</td>
            <td>{{ r.bitrate_kbps }} kbps</td>
            <td class="font-monospace small">{{ r.b2_key_prefix }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>
{% endif %}

<section class="admin-card mb-4">
  <div class="card-header d-flex align-items-center justify-content-between">
    <span>Subtitles</span>
    <span class="highlight-chip"><i class="bi bi-badge-cc"></i> {{ subtitles|length }} track(s)</span>
  </div>
  {% if subtitles|length > 0 %}
  <div class="card-body p-0 border-bottom">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>Language</th>
            <th>Label</th>
            <th>Forced</th>
            <th>Source</th>
            <th>B2 VTT Key</th>
            <th class="text-end">Action</th>
          </tr>
        </thead>
        <tbody>
          {% for s in subtitles %}
          <tr>
            <td><code>{{ s.language_code }}</code></td>
            <td>{{ s.label }}</td>
            <td>{{ s.is_forced ? 'Yes' : 'No' }}</td>
            <td><span class="badge text-bg-light border">{{ s.source == 'uploaded' ? 'uploaded' : 'extracted' }}</span></td>
            <td class="font-monospace small">{{ s.b2_vtt_key }}</td>
            <td class="text-end">
              <form method="POST" action="/admin/videos/{{ video.uuid }}/subtitles/{{ s.language_code }}/delete" class="d-inline" onsubmit="return confirm('Delete subtitle track {{ s.language_code }} ({{ s.label }})?');">
                <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
              </form>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% endif %}
  <div class="card-body">
    <h2 class="section-heading mb-1">Upload Subtitle Track</h2>
    <p class="section-hint mb-3">Accepts any ffmpeg-readable subtitle format such as `.vtt`, `.srt`, or `.ass`.</p>
    <form method="POST" action="/admin/videos/{{ video.uuid }}/subtitles/upload" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
      <div class="row g-3 align-items-end">
        <div class="col-lg-4">
          <label class="form-label" for="subtitle_file">File</label>
          <input type="file" class="form-control" id="subtitle_file" name="subtitle_file" required>
        </div>
        <div class="col-lg-2">
          <label class="form-label" for="language_code">Language code</label>
          <input type="text" class="form-control" id="language_code" name="language_code" placeholder="eng" maxlength="8" pattern="[a-z0-9]{2,8}" required list="lang-suggestions">
          <datalist id="lang-suggestions">
            <option value="eng">English</option>
            <option value="spa">Spanish</option>
            <option value="fra">French</option>
            <option value="deu">German</option>
            <option value="ita">Italian</option>
            <option value="jpn">Japanese</option>
            <option value="por">Portuguese</option>
            <option value="rus">Russian</option>
            <option value="chi">Chinese</option>
            <option value="ara">Arabic</option>
            <option value="kor">Korean</option>
          </datalist>
        </div>
        <div class="col-lg-3">
          <label class="form-label" for="sub_label">Label</label>
          <input type="text" class="form-control" id="sub_label" name="label" placeholder="Auto-detected from language code" maxlength="64">
        </div>
        <div class="col-lg-2">
          <div class="form-check mt-lg-4 pt-lg-2">
            <input class="form-check-input" type="checkbox" id="is_forced" name="is_forced" value="1">
            <label class="form-check-label" for="is_forced">Forced</label>
          </div>
        </div>
        <div class="col-lg-1">
          <button type="submit" class="btn btn-primary w-100"><i class="bi bi-upload"></i></button>
        </div>
      </div>
    </form>
  </div>
</section>

<section class="admin-card danger-card">
  <div class="card-header">Danger Zone</div>
  <div class="card-body">
    <p class="small text-muted mb-3">Permanently deletes this video, all related B2 objects, and the backing database records.</p>
    <form method="POST" action="/admin/videos/{{ video.uuid }}/delete" onsubmit="return confirm('Delete video {{ video.uuid }}? This is permanent.')">
      <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
      <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash"></i> Delete This Video</button>
    </form>
  </div>
</section>
{% endblock %}

{% block scripts %}
<script>
  (() => {
    const ACTIVE_STATUSES = new Set(['queued', 'processing', 'uploading']);
    const videoUuid = {{ video.uuid|json_encode|raw }};
    const statusBadge = document.getElementById('video-detail-status');
    const progressWrap = document.getElementById('video-detail-progress-wrap');
    const progressBar = document.getElementById('video-detail-progress-bar');
    const stageLabel = document.getElementById('video-detail-stage');
    const renditionLabel = document.getElementById('video-detail-rendition');

    const formatStage = (stage) => {
      if (!stage) {
        return '';
      }

      return stage.replace(/_/g, ' ').replace(/\b\w/g, (char) => char.toUpperCase());
    };

    let currentStatus = {{ video.status|json_encode|raw }};

    const syncView = (payload) => {
      currentStatus = payload.status || currentStatus;

      if (statusBadge) {
        statusBadge.textContent = currentStatus;
        statusBadge.className = 'badge badge-status-' + currentStatus;
      }

      if (progressWrap && progressBar) {
        const progress = Number.isFinite(payload.progress_pct) ? payload.progress_pct : 0;
        progressBar.style.width = Math.max(0, Math.min(100, progress)) + '%';
        progressBar.textContent = progress + '%';
        progressWrap.classList.toggle('d-none', !ACTIVE_STATUSES.has(currentStatus));
      }

      if (stageLabel) {
        stageLabel.textContent = formatStage(payload.current_stage || 'queued');
      }

      if (renditionLabel) {
        renditionLabel.textContent = payload.current_rendition ? 'Current rendition: ' + payload.current_rendition : '';
      }
    };

    if (!ACTIVE_STATUSES.has(currentStatus)) {
      return;
    }

    const timerId = window.setInterval(async () => {
      try {
        const response = await fetch('/admin/videos/' + videoUuid + '/progress.json', {
          credentials: 'same-origin',
          headers: { 'Accept': 'application/json' },
        });

        if (!response.ok) {
          return;
        }

        const payload = await response.json();
        syncView(payload);

        if (!ACTIVE_STATUSES.has(payload.status)) {
          window.clearInterval(timerId);
        }
      } catch (error) {
      }
    }, 5000);
  })();
</script>
{% endblock %}
