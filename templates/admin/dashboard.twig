{% extends "layout.twig" %}
{% set active_page = 'dashboard' %}

{% block title %}Dashboard{% endblock %}

{% block content %}
{% set video_defs = [
  {label:'Pending', key:'pending', icon:'bi-hourglass-split'},
  {label:'Queued', key:'queued', icon:'bi-list-check'},
  {label:'Processing', key:'processing', icon:'bi-gear-wide-connected'},
  {label:'Uploading', key:'uploading', icon:'bi-cloud-upload'},
  {label:'Ready', key:'ready', icon:'bi-check-circle'},
  {label:'Error', key:'error', icon:'bi-exclamation-octagon'},
] %}
{% set job_defs = [
  {label:'Queued', key:'queued', icon:'bi-stack'},
  {label:'Running', key:'claimed', icon:'bi-cpu'},
  {label:'Done', key:'done', icon:'bi-check2-all'},
  {label:'Failed', key:'failed', icon:'bi-bug'},
] %}

<section class="page-hero">
  <div>
    <span class="page-kicker">Operations Overview</span>
    <h1 class="page-title">Dashboard</h1>
    <p class="page-subtitle">Monitor upload volume, queue health, active workers, and recent failures from one place.</p>
    <div class="page-meta-badge">
      <i class="bi bi-activity"></i>
      <span>{{ video_total }} videos tracked across the pipeline</span>
    </div>
  </div>
  <div class="page-actions">
    <a href="/admin/videos/upload" class="btn btn-primary"><i class="bi bi-upload"></i> Upload Video</a>
    <a href="/admin/jobs" class="btn btn-outline-secondary"><i class="bi bi-cpu"></i> View Jobs</a>
  </div>
</section>

<section class="mb-4">
  <div class="d-flex align-items-center justify-content-between mb-3">
    <div>
      <h2 class="section-heading mb-1">Video States</h2>
      <div class="section-hint">A snapshot of current video lifecycle stages.</div>
    </div>
  </div>
  <div class="metric-grid">
    {% for d in video_defs %}
    <article class="metric-card">
      <div class="d-flex align-items-center justify-content-between">
        <span class="metric-label">{{ d.label }}</span>
        <i class="bi {{ d.icon }} text-secondary"></i>
      </div>
      <div class="metric-value">{{ video_stats[d.key] }}</div>
      <div class="metric-meta">Current video count in {{ d.label|lower }} state.</div>
    </article>
    {% endfor %}
  </div>
</section>

<section class="mb-4">
  <div class="d-flex align-items-center justify-content-between mb-3">
    <div>
      <h2 class="section-heading mb-1">Encoding Queue</h2>
      <div class="section-hint">How active the worker pool and retry queue are right now.</div>
    </div>
  </div>
  <div class="metric-grid">
    {% for d in job_defs %}
    <article class="metric-card">
      <div class="d-flex align-items-center justify-content-between">
        <span class="metric-label">{{ d.label }}</span>
        <i class="bi {{ d.icon }} text-secondary"></i>
      </div>
      <div class="metric-value">{{ job_stats[d.key] }}</div>
      <div class="metric-meta">Encoding jobs currently {{ d.label|lower }}.</div>
    </article>
    {% endfor %}
  </div>
</section>

<div class="row g-4 mb-4">
  <div class="col-xl-8">
    <div class="admin-card h-100">
      <div class="card-header d-flex align-items-center justify-content-between">
        <span>Active Workers</span>
        <span class="highlight-chip"><i class="bi bi-cpu"></i> {{ active_workers|length }} active</span>
      </div>
      <div class="card-body p-0">
        {% if active_workers|length == 0 %}
          <div class="empty-state">
            <div class="empty-state-icon"><i class="bi bi-cpu"></i></div>
            <div class="fw-semibold text-dark mb-1">No workers are processing jobs right now.</div>
            <div>Queued videos will appear here as soon as a worker claims them.</div>
          </div>
        {% else %}
          <div class="table-responsive">
            <table class="table table-hover align-middle">
              <thead>
                <tr>
                  <th>PID</th>
                  <th>Video</th>
                  <th>Rendition</th>
                  <th>Progress</th>
                  <th>Since</th>
                </tr>
              </thead>
              <tbody>
                {% for w in active_workers %}
                <tr>
                  <td><code>{{ w.worker_pid }}</code></td>
                  <td>
                    <a href="/admin/videos/{{ w.video_uuid }}" class="fw-semibold text-decoration-none">{{ w.original_name|slice(0, 52) }}</a>
                    <div class="small font-monospace text-muted">{{ w.video_uuid|slice(0, 8) }}…</div>
                  </td>
                  <td>{{ w.current_rendition ?? 'Waiting' }}</td>
                  <td style="min-width: 180px;">
                    <div class="progress" style="height: 0.85rem;">
                      <div class="progress-bar bg-info" style="width:{{ w.progress_pct }}%">{{ w.progress_pct }}%</div>
                    </div>
                  </td>
                  <td class="small text-muted">{{ w.claimed_at }}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="col-xl-4">
    <div class="admin-card h-100">
      <div class="card-header d-flex align-items-center justify-content-between">
        <span>Disk Usage</span>
        <span class="highlight-chip"><i class="bi bi-hdd"></i> {{ work_dir }}</span>
      </div>
      <div class="card-body">
        {% if disk_total %}
          {% set used = disk_total - disk_free %}
          {% set pct = (used / disk_total * 100)|round %}
          <div class="metric-value mb-2">{{ pct }}%</div>
          <div class="section-hint mb-3">Percentage of the configured work directory currently in use.</div>
          <div class="progress mb-3" style="height: 1rem;">
            <div class="progress-bar {{ pct > 85 ? 'bg-danger' : (pct > 65 ? 'bg-warning' : 'bg-success') }}" style="width:{{ pct }}%"></div>
          </div>
          <div class="stack-card mb-3">
            <div class="metric-label">Used Space</div>
            <div class="fw-semibold text-dark">{{ (used / 1073741824)|round(1) }} GB</div>
          </div>
          <div class="stack-card mb-3">
            <div class="metric-label">Free Space</div>
            <div class="fw-semibold text-dark">{{ (disk_free / 1073741824)|round(1) }} GB</div>
          </div>
          <div class="stack-card">
            <div class="metric-label">Total Capacity</div>
            <div class="fw-semibold text-dark">{{ (disk_total / 1073741824)|round(1) }} GB</div>
          </div>
        {% else %}
          <div class="empty-state">
            <div class="empty-state-icon"><i class="bi bi-hdd"></i></div>
            <div class="fw-semibold text-dark mb-1">Work directory not found</div>
            <div>Disk telemetry is unavailable for the configured path.</div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% if recent_errors|length > 0 %}
<section class="admin-card">
  <div class="card-header d-flex align-items-center justify-content-between">
    <span>Recent Encoding Failures</span>
    <span class="highlight-chip"><i class="bi bi-exclamation-triangle"></i> {{ recent_errors|length }} recent</span>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>Video</th>
            <th>Error</th>
            <th>When</th>
          </tr>
        </thead>
        <tbody>
          {% for e in recent_errors %}
          <tr>
            <td>
              <a href="/admin/videos/{{ e.uuid }}" class="fw-semibold text-decoration-none">{{ e.original_name|slice(0, 52) }}</a>
              <div class="small font-monospace text-muted">{{ e.uuid|slice(0, 8) }}…</div>
            </td>
            <td><code class="small">{{ e.last_error|slice(0, 140)|default('—') }}</code></td>
            <td class="small text-muted">{{ e.updated_at }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>
{% endif %}
{% endblock %}
