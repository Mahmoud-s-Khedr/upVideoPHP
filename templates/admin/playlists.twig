{% extends "layout.twig" %}
{% set active_page = 'playlists' %}

{% block title %}Playlists{% endblock %}

{% block content %}
<div class="d-flex align-items-center justify-content-between mb-4">
  <h4 class="mb-0">Playlists</h4>
  <a href="/admin/playlists/create" class="btn btn-primary btn-sm">
    <i class="bi bi-plus-lg"></i> New Playlist
  </a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-header bg-white fw-semibold d-flex align-items-center justify-content-between">
    <span>All Playlists</span>
    <span class="text-muted fw-normal small">{{ total }} total</span>
  </div>

  {% if playlists|length > 0 %}
  <div class="card-body p-0">
    <table class="table table-sm table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th>Title</th>
          <th>Description</th>
          <th class="text-center">Videos</th>
          <th>Created</th>
          <th>Updated</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
      {% for p in playlists %}
      <tr>
        <td>
          <a href="/admin/playlists/{{ p.id }}" class="fw-semibold text-decoration-none">
            {{ p.title|slice(0,60) }}
          </a>
        </td>
        <td class="text-muted small">{{ p.description ? p.description|slice(0,80) : '—' }}</td>
        <td class="text-center">
          <span class="badge bg-secondary">{{ p.video_count }}</span>
        </td>
        <td class="small text-muted">{{ p.created_at }}</td>
        <td class="small text-muted">{{ p.updated_at }}</td>
        <td>
          <a href="/admin/playlists/{{ p.id }}" class="btn btn-outline-secondary btn-sm py-0 px-2">
            <i class="bi bi-pencil"></i>
          </a>
        </td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  {% if total_pages > 1 %}
  <div class="card-footer bg-white">
    <nav>
      <ul class="pagination pagination-sm mb-0">
        {% for p in 1..total_pages %}
        <li class="page-item {% if p == page %}active{% endif %}">
          <a class="page-link" href="?page={{ p }}">{{ p }}</a>
        </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
  {% endif %}

  {% else %}
  <div class="card-body text-muted">
    No playlists yet. <a href="/admin/playlists/create">Create the first one.</a>
  </div>
  {% endif %}
</div>
{% endblock %}
