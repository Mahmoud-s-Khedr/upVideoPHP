{% extends "layout.twig" %}
{% set active_page = 'ad_analytics' %}

{% block title %}Ad Analytics{% endblock %}

{% block content %}
<section class="page-hero">
  <div>
    <span class="page-kicker">Monetization</span>
    <h1 class="page-title">Ad Analytics</h1>
    <p class="page-subtitle">Review video views and ad outcomes by video and placement to understand watch traffic, starts, completions, skips, and clicks.</p>
  </div>
</section>

{% if by_video is empty %}
  <section class="admin-card">
    <div class="empty-state">
      <div class="empty-state-icon"><i class="bi bi-bar-chart-line"></i></div>
      <div class="fw-semibold text-dark mb-1">No ad or video-view analytics recorded yet</div>
      <div>Analytics will populate here after the public watch/embed surfaces emit player and ad events.</div>
    </div>
  </section>
{% else %}
  {% for uuid, data in by_video %}
    <section class="admin-card mb-4">
      <div class="card-header d-flex align-items-center justify-content-between">
        <div>
          <div class="fw-semibold">{{ data.name }}</div>
          <div class="small font-monospace text-muted">{{ uuid }}</div>
        </div>
        <span class="highlight-chip"><i class="bi bi-bar-chart-line"></i> {{ data.ad_positions|length }} ad placements</span>
      </div>
      <div class="card-body">
        <div class="metric-grid mb-4">
          <div class="metric-card">
            <div class="metric-label">Watch Views</div>
            <div class="metric-value">{{ data.view_metrics.watch_open }}</div>
            <div class="metric-meta">Public watch page loads</div>
          </div>
          <div class="metric-card">
            <div class="metric-label">Embed Views</div>
            <div class="metric-value">{{ data.view_metrics.embed_open }}</div>
            <div class="metric-meta">Iframe player loads</div>
          </div>
          <div class="metric-card">
            <div class="metric-label">Playback Starts</div>
            <div class="metric-value">{{ data.view_metrics.playback_start }}</div>
            <div class="metric-meta">Actual plays started</div>
          </div>
          <div class="metric-card">
            <div class="metric-label">Playback Errors</div>
            <div class="metric-value">{{ data.view_metrics.playback_error }}</div>
            <div class="metric-meta">Player-side failures</div>
          </div>
          <div class="metric-card">
            <div class="metric-label">Ad Views</div>
            <div class="metric-value">{{ data.totals.ad_views }}</div>
            <div class="metric-meta">Banner, direct, and roll-ad exposures</div>
          </div>
          <div class="metric-card">
            <div class="metric-label">Ad Clicks</div>
            <div class="metric-value">{{ data.totals.ad_clicks }}</div>
            <div class="metric-meta">Tracked click-through actions</div>
          </div>
        </div>

        {% if data.ad_positions is empty %}
          <div class="empty-state pt-0">
            <div class="fw-semibold text-dark mb-1">No ad placement events recorded for this video yet</div>
            <div>Video views are tracked above. Ad rows will appear after preroll, midroll, postroll, direct-play, or banner events are emitted.</div>
          </div>
        {% else %}
          <div class="table-responsive">
            <table class="table table-hover align-middle">
              <thead>
                <tr>
                  <th>Placement</th>
                  <th class="text-end">Views</th>
                  <th class="text-end">Starts</th>
                  <th class="text-end">Completions</th>
                  <th class="text-end">Skips</th>
                  <th class="text-end">Clicks</th>
                  <th class="text-end">Completion Rate</th>
                </tr>
              </thead>
              <tbody>
                {% for position, events in data.ad_positions %}
                  {% set views = events.view ?? 0 %}
                  {% set starts = events.start ?? 0 %}
                  {% set completions = events.complete ?? 0 %}
                  {% set skips = events.skip ?? 0 %}
                  {% set clicks = events.click ?? 0 %}
                  {% set rate = starts > 0 ? ((completions / starts) * 100)|round(1) : 0 %}
                  <tr>
                    <td>
                      <span class="badge text-bg-light border">{{ position|replace({'_': ' '})|title }}</span>
                    </td>
                    <td class="text-end">{{ views }}</td>
                    <td class="text-end">{{ starts }}</td>
                    <td class="text-end">{{ completions }}</td>
                    <td class="text-end">{{ skips }}</td>
                    <td class="text-end">{{ clicks }}</td>
                    <td class="text-end fw-semibold">{{ rate }}%</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% endif %}
      </div>
    </section>
  {% endfor %}
{% endif %}
{% endblock %}
