{% extends "layout.twig" %}
{% set active_page = 'videos' %}

{% block title %}Upload Videos{% endblock %}

{% block content %}
<section class="page-hero">
  <div>
    <span class="page-kicker">Admin Upload</span>
    <h1 class="page-title">Upload Videos</h1>
    <p class="page-subtitle">Upload one or more source files for background encoding. Files are sent directly to storage without passing through the server.</p>
  </div>
  <div class="page-actions">
    <a href="/admin/videos" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left"></i> Back to Videos
    </a>
  </div>
</section>

<div class="upload-shell">
  {# data-csrf and data-max-bytes are read by JS #}
  <form id="upload-form" data-csrf="{{ csrf_token() }}" data-max-bytes="{{ max_upload_bytes }}">

    {# ── Drop Zone ─────────────────────────────────────────────────────────── #}
    <div class="upload-card mb-4">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
          <div>
            <h5 class="upload-card-title mb-1">Source Files</h5>
            <p class="upload-muted mb-0">Drag videos here or click to browse. Multiple files can be selected at once.</p>
          </div>
          <span class="highlight-chip">Step 1</span>
        </div>

        <label class="upload-dropzone" id="dropzone" for="file-input" tabindex="0" role="button">
          <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center gap-3">
            <span class="upload-dropzone-icon">
              <i class="bi bi-cloud-arrow-up"></i>
            </span>
            <div>
              <div class="fw-semibold text-dark mb-1">Drop video files here</div>
              <div class="upload-muted">
                MP4, MOV, MKV, TS, AVI, WebM &middot;
                Max {{ (max_upload_bytes / 1073741824)|round(1) }} GB per file
              </div>
            </div>
          </div>
          <input type="file" class="visually-hidden" id="file-input" multiple
                 accept=".mp4,.mkv,.ts,.avi,.mov,.webm,video/mp4,video/x-matroska,video/mp2t,video/x-msvideo,video/vnd.avi,video/quicktime,video/webm,text/vnd.trolltech.linguist">
        </label>
      </div>
    </div>

    {# ── Quality Targets ──────────────────────────────────────────────────── #}
    <div class="upload-card mb-4">
      <div class="card-body p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
          <div>
            <h5 class="upload-card-title mb-1">Target Qualities</h5>
            <p class="upload-muted mb-0">Applied to every file in this batch. Leave unchecked to encode all applicable renditions automatically.</p>
          </div>
          <span class="highlight-chip">Step 2</span>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center upload-quality-toolbar mb-3">
          <div class="small upload-muted upload-quality-count" id="quality-summary">
            2 selected: 1080p, 540p
          </div>
          <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm"
                    data-quality-values="{{ all_quality_labels|join(',') }}">All</button>
            <button type="button" class="btn btn-outline-secondary btn-sm"
                    data-quality-values="1080p,720p">HD</button>
            <button type="button" class="btn btn-outline-secondary btn-sm"
                    data-quality-values="720p,540p,360p">Compact</button>
            <button type="button" class="btn btn-outline-secondary btn-sm"
                    data-quality-values="">Clear</button>
          </div>
        </div>

        <div class="row g-3">
          {% for quality in all_quality_labels %}
          <div class="col-sm-6 col-lg-4">
            <label class="quality-tile">
              <input class="form-check-input quality-checkbox" type="checkbox"
                     value="{{ quality }}"
                     {% if quality in ['1080p', '540p'] %}checked{% endif %}>
              <span class="quality-tile-meta">
                <span class="d-block fw-semibold quality-tile-title">{{ quality }}</span>
                <span class="small text-muted">Include this rendition in the encoding queue.</span>
              </span>
            </label>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>

    {# ── File Queue (hidden until files are added) ─────────────────────────── #}
    <div id="file-queue-wrapper" class="d-none mb-4">
      <div class="upload-card">
        <div class="card-body p-4">
          <h5 class="upload-card-title mb-3">File Queue</h5>
          <div id="file-queue"></div>
        </div>
      </div>
    </div>

    {# ── Actions bar ──────────────────────────────────────────────────────── #}
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
      <div class="d-flex align-items-center gap-3">
        <span class="small upload-muted" id="upload-summary">0 of 0 queued</span>
        <button type="button" id="clear-btn" class="btn btn-link btn-sm text-danger p-0 d-none">Remove all</button>
      </div>
      <button type="submit" id="upload-btn" class="btn btn-primary px-4" disabled>
        <i class="bi bi-upload me-1"></i>
        <span id="upload-btn-text">Upload Files</span>
      </button>
    </div>

  </form>
</div>
{% endblock %}

{% block scripts %}
<script>
(() => {
  'use strict';

  const form         = document.getElementById('upload-form');
  const fileInput    = document.getElementById('file-input');
  const dropzone     = document.getElementById('dropzone');
  const fileQueue    = document.getElementById('file-queue');
  const queueWrapper = document.getElementById('file-queue-wrapper');
  const uploadBtn    = document.getElementById('upload-btn');
  const uploadBtnTxt = document.getElementById('upload-btn-text');
  const uploadSummary = document.getElementById('upload-summary');
  const clearBtn     = document.getElementById('clear-btn');
  const qualityInputs = Array.from(document.querySelectorAll('.quality-checkbox'));
  const presetBtns   = Array.from(document.querySelectorAll('[data-quality-values]'));
  const qualSummary  = document.getElementById('quality-summary');

  const CSRF          = form.dataset.csrf;
  const MAX_BYTES     = parseInt(form.dataset.maxBytes, 10);
  const CONCURRENCY   = 3;
  const ALLOWED_TYPES = ['video/mp4','video/x-matroska','video/mp2t','video/x-msvideo','video/vnd.avi','video/quicktime','video/webm','text/vnd.trolltech.linguist'];
  const ALLOWED_EXTS  = ['mp4','mkv','ts','avi','mov','webm'];

  // ── State ──────────────────────────────────────────────────────────────────
  let nextId       = 0;
  const registry   = new Map(); // id → { file, state, el, uuid }
  let activeCount  = 0;
  let batchRunning = false;

  // ── Helpers ────────────────────────────────────────────────────────────────
  function formatBytes(bytes) {
    if (!bytes || bytes <= 0) return '0 B';
    const units = ['B', 'KB', 'MB', 'GB', 'TB'];
    const e = Math.min(Math.floor(Math.log(bytes) / Math.log(1024)), units.length - 1);
    const v = bytes / Math.pow(1024, e);
    return v.toFixed(e === 0 || v >= 100 ? 0 : 1) + ' ' + units[e];
  }

  function escHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function getSelectedQualities() {
    return qualityInputs.filter(i => i.checked).map(i => i.value);
  }

  function updateQualitySummary() {
    const sel = getSelectedQualities();
    qualSummary.textContent = sel.length === 0
      ? 'No qualities selected — all applicable renditions will be encoded.'
      : sel.length + ' selected: ' + sel.join(', ');
  }

  function updateSummary() {
    const total  = registry.size;
    const queued = [...registry.values()].filter(e => e.state === 'queued').length;
    const errors = [...registry.values()].filter(e => e.state === 'error').length;
    if (total === 0) { uploadSummary.textContent = '0 of 0 queued'; return; }
    let txt = queued + ' of ' + total + ' queued';
    if (errors > 0) txt += ' \u00b7 ' + errors + ' error' + (errors > 1 ? 's' : '');
    uploadSummary.textContent = txt;
  }

  function updateUploadBtn() {
    const pending = [...registry.values()].filter(e => e.state === 'pending').length;
    if (batchRunning) {
      uploadBtn.disabled = true;
      uploadBtnTxt.textContent = 'Uploading\u2026';
      return;
    }
    uploadBtn.disabled = pending === 0;
    const n = pending > 0 ? pending : registry.size;
    uploadBtnTxt.textContent = 'Upload ' + n + ' File' + (n !== 1 ? 's' : '');
  }

  function setControlsDisabled(disabled) {
    qualityInputs.forEach(i => { i.disabled = disabled; });
    presetBtns.forEach(b => { b.disabled = disabled; });
    clearBtn.disabled = disabled;
    dropzone.classList.toggle('is-disabled', disabled);
  }

  // ── Per-file card ──────────────────────────────────────────────────────────
  function createFileCard(id, file) {
    const el = document.createElement('div');
    el.className = 'file-row border rounded p-3 mb-2';
    el.dataset.fileId = id;
    el.innerHTML =
      '<div class="d-flex justify-content-between align-items-start gap-2 mb-2">' +
        '<div class="d-flex align-items-center gap-2 flex-grow-1 overflow-hidden">' +
          '<span class="fw-semibold text-truncate filename">' + escHtml(file.name) + '</span>' +
          '<span class="badge text-bg-light border flex-shrink-0 filesize">' + formatBytes(file.size) + '</span>' +
        '</div>' +
        '<div class="d-flex align-items-center gap-2 flex-shrink-0">' +
          '<span class="badge file-status-badge bg-secondary">Waiting</span>' +
          '<button type="button" class="btn-close btn-remove" aria-label="Remove" title="Remove"></button>' +
        '</div>' +
      '</div>' +
      '<div class="progress mb-1" style="height:6px">' +
        '<div class="progress-bar file-progress-bar" style="width:0%"></div>' +
      '</div>' +
      '<small class="file-message text-muted d-block"></small>';

    el.querySelector('.btn-remove').addEventListener('click', () => removeFile(id));
    fileQueue.appendChild(el);
    return el;
  }

  function setCardState(entry, state, data) {
    const badge = entry.el.querySelector('.file-status-badge');
    const bar   = entry.el.querySelector('.file-progress-bar');
    const msg   = entry.el.querySelector('.file-message');
    const rm    = entry.el.querySelector('.btn-remove');

    // 'progress' is a sub-state of uploading — don't update entry.state
    if (state === 'progress') {
      const pct = Math.round((data && data.pct) ? data.pct : 0);
      badge.textContent = 'Uploading ' + pct + '%';
      bar.style.width   = pct + '%';
      bar.className     = 'progress-bar file-progress-bar bg-info';
      if (data && data.loaded && data.total) {
        msg.textContent = formatBytes(data.loaded) + ' of ' + formatBytes(data.total);
      }
      return;
    }

    entry.state = state;
    badge.className = 'badge file-status-badge';
    rm.disabled = (state !== 'pending');

    switch (state) {
      case 'pending':
        badge.classList.add('bg-secondary');
        badge.textContent = 'Waiting';
        bar.style.width   = '0%';
        bar.className     = 'progress-bar file-progress-bar';
        msg.textContent   = '';
        break;

      case 'init':
        badge.classList.add('bg-info', 'text-dark');
        badge.textContent = 'Initialising\u2026';
        break;

      case 'uploading':
        badge.classList.add('bg-info', 'text-dark');
        badge.textContent = 'Uploading 0%';
        bar.className     = 'progress-bar file-progress-bar progress-bar-striped progress-bar-animated bg-info';
        break;

      case 'completing':
        badge.classList.add('bg-warning', 'text-dark');
        badge.textContent = 'Processing\u2026';
        bar.style.width   = '100%';
        bar.className     = 'progress-bar file-progress-bar bg-warning';
        break;

      case 'queued':
        badge.classList.add('bg-success');
        badge.textContent = 'Queued \u2713';
        bar.style.width   = '100%';
        bar.className     = 'progress-bar file-progress-bar bg-success';
        if (data && data.redirect) {
          msg.innerHTML = '<a href="' + escHtml(data.redirect) + '" class="text-success">View video \u2192</a>';
        }
        break;

      case 'error':
        badge.classList.add('bg-danger');
        badge.textContent = 'Error';
        bar.style.width   = '100%';
        bar.className     = 'progress-bar file-progress-bar bg-danger';
        msg.textContent   = (data && data.message) ? data.message : 'Unknown error';
        break;
    }
  }

  // ── File management ────────────────────────────────────────────────────────
  function isAccepted(file) {
    const type = (file.type || '').toLowerCase();
    const ext  = (file.name.split('.').pop() || '').toLowerCase();
    if (!ALLOWED_TYPES.includes(type) && !ALLOWED_EXTS.includes(ext)) {
      return false; // silently skip non-video files
    }
    if (file.size > MAX_BYTES) {
      // eslint-disable-next-line no-alert
      alert(file.name + ' exceeds the maximum file size (' + formatBytes(MAX_BYTES) + ').');
      return false;
    }
    return true;
  }

  function addFiles(fileList) {
    let added = 0;
    for (const file of fileList) {
      if (!isAccepted(file)) continue;
      const id = ++nextId;
      const el = createFileCard(id, file);
      registry.set(id, { file, state: 'pending', el, uuid: null });
      added++;
    }
    if (added > 0) {
      queueWrapper.classList.remove('d-none');
      clearBtn.classList.remove('d-none');
      updateSummary();
      updateUploadBtn();
    }
  }

  function removeFile(id) {
    const entry = registry.get(id);
    if (!entry || entry.state !== 'pending') return;
    entry.el.remove();
    registry.delete(id);
    if (registry.size === 0) {
      queueWrapper.classList.add('d-none');
      clearBtn.classList.add('d-none');
    }
    updateSummary();
    updateUploadBtn();
  }

  // ── Upload pipeline ────────────────────────────────────────────────────────
  async function processFile(entry) {
    setCardState(entry, 'init');

    // 1. Init — get presigned PUT URL
    const initRes = await fetch('/admin/videos/upload/init', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        _csrf: CSRF,
        filename: entry.file.name,
        size_bytes: entry.file.size,
        content_type: entry.file.type || 'video/mp4',
        target_qualities: getSelectedQualities(),
      }),
    });
    const initData = await initRes.json();
    if (!initRes.ok) throw new Error(initData.message || 'Init failed');
    entry.uuid = initData.video_uuid;

    // 2. PUT directly to B2 with progress tracking
    setCardState(entry, 'uploading');
    await uploadToB2(entry, initData.upload_url);

    // 3. Complete — queue encoding job
    setCardState(entry, 'completing');
    const completeRes = await fetch('/admin/videos/upload/complete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ _csrf: CSRF, video_uuid: entry.uuid }),
    });
    const completeData = await completeRes.json();
    if (!completeRes.ok) throw new Error(completeData.message || 'Complete failed');

    setCardState(entry, 'queued', completeData);
  }

  function uploadToB2(entry, url) {
    return new Promise((resolve, reject) => {
      const xhr = new XMLHttpRequest();
      xhr.open('PUT', url);
      xhr.setRequestHeader('Content-Type', entry.file.type || 'video/mp4');

      xhr.upload.addEventListener('progress', e => {
        if (e.lengthComputable) {
          setCardState(entry, 'progress', {
            pct: (e.loaded / e.total) * 100,
            loaded: e.loaded,
            total: e.total,
          });
        }
      });

      xhr.addEventListener('load', () => {
        if (xhr.status >= 200 && xhr.status < 300) {
          resolve();
        } else {
          reject(new Error('B2 upload failed: HTTP ' + xhr.status));
        }
      });
      xhr.addEventListener('error', () => reject(new Error('Network error during upload')));
      xhr.send(entry.file);
    });
  }

  // Concurrency pool: start up to CONCURRENCY files at once
  function runQueue() {
    const pending = [...registry.values()].filter(e => e.state === 'pending');
    const slots   = CONCURRENCY - activeCount;
    const batch   = pending.slice(0, slots);

    for (const entry of batch) {
      activeCount++;
      processFile(entry)
        .catch(err => setCardState(entry, 'error', { message: err.message }))
        .finally(() => {
          activeCount--;
          updateSummary();
          runQueue();
          if (activeCount === 0) {
            batchRunning = false;
            setControlsDisabled(false);
            updateUploadBtn();
          }
        });
    }
  }

  // ── Event listeners ────────────────────────────────────────────────────────
  fileInput.addEventListener('change', () => {
    if (fileInput.files) addFiles(fileInput.files);
    // Reset so the same file can be re-added after removal
    fileInput.value = '';
  });

  ['dragenter', 'dragover'].forEach(ev => {
    dropzone.addEventListener(ev, e => {
      e.preventDefault();
      if (!batchRunning) dropzone.classList.add('is-dragover');
    });
  });

  ['dragleave', 'dragend', 'drop'].forEach(ev => {
    dropzone.addEventListener(ev, e => {
      e.preventDefault();
      dropzone.classList.remove('is-dragover');
    });
  });

  dropzone.addEventListener('drop', e => {
    if (!batchRunning && e.dataTransfer && e.dataTransfer.files) {
      addFiles(e.dataTransfer.files);
    }
  });

  dropzone.addEventListener('click', e => {
    if (batchRunning) e.preventDefault();
  });

  dropzone.addEventListener('keydown', e => {
    if ((e.key === 'Enter' || e.key === ' ') && !batchRunning) {
      e.preventDefault();
      fileInput.click();
    }
  });

  clearBtn.addEventListener('click', () => {
    if (batchRunning) return;
    [...registry.keys()].forEach(id => removeFile(id));
  });

  qualityInputs.forEach(i => i.addEventListener('change', updateQualitySummary));

  presetBtns.forEach(btn => btn.addEventListener('click', () => {
    const vals = (btn.dataset.qualityValues || '').split(',').map(v => v.trim()).filter(Boolean);
    const set  = new Set(vals);
    qualityInputs.forEach(i => { i.checked = set.has(i.value); });
    updateQualitySummary();
  }));

  form.addEventListener('submit', e => {
    e.preventDefault();
    if (batchRunning) return;
    const pending = [...registry.values()].filter(e => e.state === 'pending');
    if (pending.length === 0) return;
    batchRunning = true;
    updateUploadBtn();
    setControlsDisabled(true);
    updateSummary();
    runQueue();
  });

  // ── Init ───────────────────────────────────────────────────────────────────
  updateQualitySummary();
  updateUploadBtn();
})();
</script>
{% endblock %}
