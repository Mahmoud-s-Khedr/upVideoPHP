<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ video.original_name|default('Video')|slice(0, 80) }}</title>
  <link rel="icon" href="/favicon.ico">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Sora:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="{{ base_url }}/assets/player/player.css">
</head>
<body class="vp-watch-body">
  <div class="vp-watch-shell">
    {% if embed_settings.watch_top_banner_html %}
      <div class="vp-watch-banner">{{ embed_settings.watch_top_banner_html|raw }}</div>
    {% endif %}

    <div class="vp-watch-grid">
      <main class="vp-watch-player-card">
        <span class="vp-watch-kicker"><i class="bi bi-play-circle"></i> Public Watch Page</span>
        <h1 class="vp-watch-title">{{ video.original_name|default('Untitled') }}</h1>
        <div class="vp-watch-meta">
          {% if video.duration_sec %}
            <span class="vp-watch-chip"><i class="bi bi-clock"></i> {{ (video.duration_sec / 60)|round(1) }} min</span>
          {% endif %}
          <span class="vp-watch-chip"><i class="bi bi-shield-check"></i> Secure playback</span>
        </div>
        <div class="vp-watch-subtitle mb-3">Optimized delivery with a fallback to the original file while transcoding completes.</div>
        {% include '_player.twig' %}
      </main>

      <aside class="vp-watch-sidecard">
        <h2>Share this video</h2>
        <p class="mb-3">Use the public watch URL for direct viewing, or mint a signed embed session from the API for iframe integrations.</p>
        <textarea class="vp-watch-code" id="watch-url" readonly>{{ base_url }}/watch/{{ video.uuid }}</textarea>
        <div class="vp-watch-actions mt-3">
          <button class="vp-watch-btn" type="button" onclick="navigator.clipboard.writeText(document.getElementById('watch-url').value)">Copy watch URL</button>
        </div>

        <hr class="border-secondary-subtle my-4">

        <h3>Embed workflow</h3>
        <p class="mb-2">Use the stable embed URL on an allowed origin, or mint a signed session from the API when you need a backend-issued URL.</p>
        <textarea class="vp-watch-code" readonly>&lt;iframe
  src="{{ base_url }}/embed/video/{{ video.uuid }}"
  width="800"
  height="450"
  allow="autoplay; fullscreen; picture-in-picture"
  referrerpolicy="strict-origin-when-cross-origin"
  loading="lazy"
  style="border:none;"
&gt;&lt;/iframe&gt;</textarea>
      </aside>
    </div>

    {% if embed_settings.watch_bottom_banner_html %}
      <div class="vp-watch-banner">{{ embed_settings.watch_bottom_banner_html|raw }}</div>
    {% endif %}

    {% if embed_settings.general_html_code %}
      <div class="vp-watch-banner">{{ embed_settings.general_html_code|raw }}</div>
    {% endif %}
  </div>

  {% if embed_settings.general_script_url %}
    <script async src="{{ embed_settings.general_script_url }}"></script>
  {% endif %}
  <script>
    window.__VP_CONFIG = {
      mode: 'watch',
      videoUuid: {{ video.uuid|json_encode|raw }},
      baseUrl: {{ base_url|json_encode|raw }},
      bootstrapUrl: {{ bootstrap_url|json_encode|raw }},
      bootstrap: {{ bootstrap_json|raw }},
      sessionId: {{ session_id|json_encode|raw }}
    };
  </script>
  <script src="{{ base_url }}/assets/player/hls.min.js"></script>
  <script src="{{ base_url }}/assets/player/player.js"></script>
</body>
</html>
