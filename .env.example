# ============================================================================
# PHP HLS Streaming System — Environment Configuration
# Copy this file to .env and fill in every value marked REQUIRED.
# Never commit .env to version control.
# Set file permissions: chmod 600 .env && chown www-data:www-data .env
# ============================================================================

# ----------------------------------------------------------------------------
# Database (MySQL 8.0+ or MariaDB 10.6+)  — all REQUIRED
# ----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=videosystem
DB_USER=videosystem
DB_PASS=

# ----------------------------------------------------------------------------
# Backblaze B2 (S3-compatible)  — all REQUIRED
# The bucket MUST be private — delivery goes through PHP pre-signed redirects.
# ----------------------------------------------------------------------------
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=my-video-bucket
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004

# Optional: public-facing endpoint embedded in presigned PUT URLs returned to browsers.
# Set this when the endpoint reachable by PHP containers differs from the URL that
# browsers use (e.g. MinIO running in Docker behind a TLS-terminating nginx on the host).
# Leave empty to use B2_ENDPOINT for both internal calls and presigned URLs.
B2_PUBLIC_ENDPOINT=

# Lifetime in seconds for presigned B2 PUT URLs issued to clients for direct upload (default: 4 hours).
# Increase for very slow connections or large files. Uploading 5 GB at 10 Mbps takes ~67 minutes,
# so the default of 4 hours gives ample headroom.
B2_UPLOAD_PRESIGN_TTL_SECONDS=14400

# ----------------------------------------------------------------------------
# Security  — all REQUIRED
# ----------------------------------------------------------------------------

# HMAC key for stream tokens. Generate with:
#   openssl rand -base64 48
STREAM_TOKEN_SECRET=

# Stream token lifetime in seconds (default: 4 hours)
STREAM_TOKEN_TTL_SECONDS=14400

# HMAC key for embed tokens (separate from stream tokens). Generate with:
#   openssl rand -base64 48
EMBED_TOKEN_SECRET=

# Embed token lifetime in seconds (default: 4 hours)
EMBED_TOKEN_TTL_SECONDS=14400

# AES-256 key used to encrypt HLS key material stored in the DB.
# Must be exactly 64 hex characters (= 32 raw bytes). Generate with:
#   openssl rand -hex 32
KEY_ENCRYPTION_SECRET=

# ----------------------------------------------------------------------------
# Application  — REQUIRED
# ----------------------------------------------------------------------------

# Public HTTPS base URL — used in HLS #EXT-X-KEY URIs baked into playlists.
# Wrong value = playback failure. No trailing slash.
APP_BASE_URL=https://yourdomain.com

# Comma-separated list of trusted reverse-proxy IPs (e.g. "127.0.0.1,10.0.0.1").
# Only requests arriving from these IPs have their X-Forwarded-For header trusted
# for IP binding on stream tokens. Leave empty to always use REMOTE_ADDR directly.
TRUSTED_PROXIES=

# CORS allowed origin for browser HLS players.
# Set to the exact player origin (e.g. https://player.yourdomain.com).
# Leave empty to disable CORS headers entirely.
# Must NOT be '*' when cookie-based stream tokens are used.
CORS_ALLOWED_ORIGIN=https://yourdomain.com

# ----------------------------------------------------------------------------
# FFmpeg binaries
# ----------------------------------------------------------------------------
FFMPEG_BIN=/usr/bin/ffmpeg
FFPROBE_BIN=/usr/bin/ffprobe

# Hard wall-clock timeout for one FFmpeg rendition process (minutes).
# A stuck encode is terminated after this limit.
FFMPEG_MAX_MINUTES=360

# ----------------------------------------------------------------------------
# File storage (VPS local working directory)
# Must be outside the web root; owned and writable by www-data.
# Peak usage: ≥ 20 GB during active encodes (two concurrent 10 GB sources).
# ----------------------------------------------------------------------------
WORK_DIR=/var/video-work

# Maximum accepted upload size in bytes (default: 20 GB)
MAX_UPLOAD_BYTES=21474836480

# Multipart chunk size for uploads larger than 5 GB (bytes).
# Default 64 MB. Keep >= 5 MB for S3-compatible multipart APIs.
MULTIPART_PART_SIZE_BYTES=67108864

# ----------------------------------------------------------------------------
# Worker / queue
# ----------------------------------------------------------------------------

# Seconds between queue poll loops when no job is available
WORKER_POLL_INTERVAL=5

# Jobs with no heartbeat activity for longer than this are reset by the reaper.
# The reaper uses the worker's heartbeat_at timestamp (updated every ~2 seconds during
# encoding) rather than claim time, so this threshold only needs to cover genuine
# hangs/crashes — not the full encoding duration. Default 120 minutes provides
# headroom for long processing stages with low log output.
STALE_JOB_TIMEOUT_MINUTES=120

# Videos that remain in 'pending' status (upload init called but file never
# PUT to storage) are marked 'error' by the reaper after this many minutes.
# Should be >= B2_UPLOAD_PRESIGN_TTL_SECONDS / 60 (default: 60 = 1 hour).
PENDING_UPLOAD_TTL_MINUTES=60

# Workers pause and wait when free disk space drops below this value (bytes).
# Default: 20 GB
MIN_DISK_FREE_BYTES=21474836480
